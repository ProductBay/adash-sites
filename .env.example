DATABASE_URL="postgresql://postgres:postgres@localhost:5432/adash_sites?schema=public"
NODE_ENV="development"
ADASH_SITES_ROOT_DOMAIN="sites.adash.technology"
ADASH_MEDIA_DRIVER="local"
# Required by both admin and runtime when ADASH_MEDIA_DRIVER="s3". Never expose these as NEXT_PUBLIC_*.
ADASH_MEDIA_BUCKET=""
ADASH_MEDIA_ENDPOINT=""
ADASH_MEDIA_REGION="auto"
ADASH_MEDIA_ACCESS_KEY_ID=""
ADASH_MEDIA_SECRET_ACCESS_KEY=""
