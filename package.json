{
  "name": "adash-sites",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "visual:check": "node scripts/visual-check.mjs",
    "build": "npm run build --workspace @adash/site-runtime && npm run build --workspace @adash/sites-admin",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^15.3.0",
    "playwright-core": "^1.64.0",
    "prisma": "^6.8.0",
    "tsx": "^4.19.0",
    "vitest": "^3.1.0"
  },
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^3.24.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.15.0",
    "typescript": "^5.8.0",
    "@types/react-dom": "^19.1.0",
    "@types/react": "^19.3.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
